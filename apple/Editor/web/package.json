{
  "name": "neoscad-editor",
  "private": true,
  "version": "0.1.0",
  "description": "The NeoSCAD editor: CodeMirror 6 with OpenSCAD language support, bundled for the macOS app's web view.",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "grammar": "node build.mjs --grammar",
    "build": "node build.mjs",
    "pretest": "node build.mjs --grammar",
    "test": "node --test test/*.test.js",
    "corpus": "node test/corpus.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.12.4",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@lezer/common": "1.5.3",
    "@lezer/highlight": "1.2.4",
    "@lezer/lr": "1.4.10"
  },
  "devDependencies": {
    "@lezer/generator": "1.8.1",
    "esbuild": "0.28.2"
  }
}
