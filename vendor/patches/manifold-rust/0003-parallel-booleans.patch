+    T: Send,
+    F: Fn(T) + Sync + Send,
+{
+    use rayon::prelude::*;
+    if items.len() >= threshold {
+        items.into_par_iter().for_each(f);
+    } else {
+        items.into_iter().for_each(f);
+    }
