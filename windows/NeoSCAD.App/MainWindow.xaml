<?xml version="1.0" encoding="utf-8"?>
<!--
  A document window: menu bar (with the AI agent control at its right
  end), then the editor (left) beside the 3D view
  over the console (right), with the side panels (customizer, check,
  measure) in a SplitView pane on the far right, and a status line. Mica
  behind it all, the system's light or dark theme throughout (the view's
  colour scheme follows it too; ViewportPanel.cs).

  Every chord the editor page forwards (NeoSCAD.Host/Shortcuts.cs) is also
  a KeyboardAccelerator here; NeoSCAD.Tests checks that they agree. The
  Edit menu's keys are CodeMirror's own, so its items only show them
  (KeyboardAcceleratorTextOverride): a live Ctrl+Z here would undo the
  editor while the focus is in a customizer field.
-->
<Window
    x:Class="NeoSCAD.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="NeoSCAD">
  <Window.SystemBackdrop>
    <MicaBackdrop />
  </Window.SystemBackdrop>

  <Grid x:Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- The menu row: the menus, then the agent control at its right end
         (MainWindow.Agents.cs; the audit's Windows spec puts it there, as
         the window has a MenuBar and no CommandBar). -->
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <MenuBar Grid.Column="0">
        <MenuBarItem Title="File">
          <MenuFlyoutItem Text="New" Click="OnNew">
            <MenuFlyoutItem.KeyboardAccelerators>
              <KeyboardAccelerator Modifiers="Control" Key="N" />
            </MenuFlyoutItem.KeyboardAccelerators>
          </MenuFlyoutItem>
          <MenuFlyoutItem Text="Open…" Click="OnOpen">
            <MenuFlyoutItem.KeyboardAccelerators>
              <KeyboardAccelerator Modifiers="Control" Key="O" />
            </MenuFlyoutItem.KeyboardAccelerators>
          </MenuFlyoutItem>
          <MenuFlyoutSubItem x:Name="ExamplesMenu" Text="Examples" />
          <MenuFlyoutSeparator />
          <MenuFlyoutItem Text="Save" Click="OnSave">
            <MenuFlyoutItem.KeyboardAccelerators>
              <KeyboardAccelerator Modifiers="Control" Key="S" />
            </MenuFlyoutItem.KeyboardAccelerators>
          </MenuFlyoutItem>
          <MenuFlyoutItem Text="Save As…" Click="OnSaveAs">
            <MenuFlyoutItem.KeyboardAccelerators>
              <KeyboardAccelerator Modifiers="Control,Shift" Key="S" />
            </MenuFlyoutItem.KeyboardAccelerators>
          </MenuFlyoutItem>
          <MenuFlyoutSeparator />
          <MenuFlyoutItem x:Name="ExportAgainItem" Text="Export…" Click="OnExportAgain">
            <MenuFlyoutItem.KeyboardAccelerators>
              <KeyboardAccelerator Modifiers="Control,Shift" Key="E" />
            </MenuFlyoutItem.KeyboardAccelerators>
          </MenuFlyoutItem>
          <MenuFlyoutSubItem x:Name="ExportMenu" Text="Export As" />
          <MenuFlyoutSeparator />
          <MenuFlyoutItem Text="Exit" Click="OnExit" />
        </MenuBarItem>
        <MenuBarItem Title="Edit">
          <MenuFlyoutItem Text="Undo" Click="OnUndo" KeyboardAcceleratorTextOverride="Ctrl+Z" />
          <MenuFlyoutItem Text="Redo" Click="OnRedo" KeyboardAcceleratorTextOverride="Ctrl+Y" />
          <MenuFlyoutSeparator />
          <MenuFlyoutItem Text="Select All" Click="OnSelectAll" KeyboardAcceleratorTextOverride="Ctrl+A" />
          <MenuFlyoutItem Text="Find…" Click="OnFind" KeyboardAcceleratorTextOverride="Ctrl+F" />
        </MenuBarItem>
        <MenuBarItem Title="Design">
          <MenuFlyoutItem Text="Preview" Click="OnPreview">
            <MenuFlyoutItem.KeyboardAccelerators>
              <KeyboardAccelerator Key="F5" />
            </MenuFlyoutItem.KeyboardAccelerators>
          </MenuFlyoutItem>
          <MenuFlyoutItem Text="Render" Click="OnRender">
            <MenuFlyoutItem.KeyboardAccelerators>
              <KeyboardAccelerator Key="F6" />
            </MenuFlyoutItem.KeyboardAccelerators>
          </MenuFlyoutItem>
          <MenuFlyoutSeparator />
          <MenuFlyoutItem Text="Check" Click="OnCheck">
            <MenuFlyoutItem.KeyboardAccelerators>
              <KeyboardAccelerator Modifiers="Control,Shift" Key="K" />
            </MenuFlyoutItem.KeyboardAccelerators>
          </MenuFlyoutItem>
          <MenuFlyoutItem Text="Measure" Click="OnMeasure">
            <MenuFlyoutItem.KeyboardAccelerators>
              <KeyboardAccelerator Modifiers="Control,Shift" Key="M" />
            </MenuFlyoutItem.KeyboardAccelerators>
          </MenuFlyoutItem>
          <MenuFlyoutSeparator />
          <MenuFlyoutSubItem Text="NeoSCAD Extensions">
            <ToggleMenuFlyoutItem x:Name="SketchItem" Text="Constrained Sketches (sketch)" Click="OnSketchToggle" />
            <ToggleMenuFlyoutItem x:Name="QueryItem" Text="Geometry Queries (query)" Click="OnQueryToggle" />
            <ToggleMenuFlyoutItem x:Name="ExactItem" Text="Exact STEP Export (exact)" Click="OnExactToggle" />
            <ToggleMenuFlyoutItem x:Name="FilletItem" Text="Edge Fillets and Chamfers (fillet)" Click="OnFilletToggle" />
          </MenuFlyoutSubItem>
        </MenuBarItem>
        <MenuBarItem Title="View">
          <MenuFlyoutItem Text="View All" Click="OnViewAll" />
          <MenuFlyoutItem Text="Reset View" Click="OnResetView" />
          <MenuFlyoutSeparator />
          <MenuFlyoutItem Text="Top" Tag="Top" Click="OnPreset" />
          <MenuFlyoutItem Text="Bottom" Tag="Bottom" Click="OnPreset" />
          <MenuFlyoutItem Text="Left" Tag="Left" Click="OnPreset" />
          <MenuFlyoutItem Text="Right" Tag="Right" Click="OnPreset" />
          <MenuFlyoutItem Text="Front" Tag="Front" Click="OnPreset" />
          <MenuFlyoutItem Text="Back" Tag="Back" Click="OnPreset" />
          <MenuFlyoutItem Text="Diagonal" Tag="Diagonal" Click="OnPreset" />
          <MenuFlyoutSeparator />
          <ToggleMenuFlyoutItem x:Name="CustomizerItem" Text="Customizer" Tag="customizer" Click="OnPanelItem">
            <ToggleMenuFlyoutItem.KeyboardAccelerators>
              <KeyboardAccelerator Modifiers="Control,Shift" Key="P" />
            </ToggleMenuFlyoutItem.KeyboardAccelerators>
          </ToggleMenuFlyoutItem>
          <ToggleMenuFlyoutItem x:Name="CheckItem" Text="Check Panel" Tag="check" Click="OnPanelItem" />
          <ToggleMenuFlyoutItem x:Name="MeasureItem" Text="Measure Panel" Tag="measure" Click="OnPanelItem" />
        </MenuBarItem>
        <MenuBarItem Title="Help">
          <MenuFlyoutItem Text="Connect Your AI Agent…" Click="OnConnectAgent" />
          <MenuFlyoutItem Text="Using NeoSCAD with AI Agents" Click="OnAgentHelp" />
          <ToggleMenuFlyoutItem x:Name="AllowAgentsItem" Text="Allow AI Agents to Work on Open Documents" Click="OnAllowAgentsToggle" />
          <ToggleMenuFlyoutItem x:Name="AskAgentEditsItem" Text="Ask Before Applying Agent Edits" Click="OnAskAgentEditsToggle" />
          <MenuFlyoutSeparator />
          <MenuFlyoutItem Text="Check for Updates…" Click="OnCheckForUpdates" />
          <MenuFlyoutSeparator />
          <ToggleMenuFlyoutItem x:Name="AutoUpdateItem" Text="Check for Updates Automatically" Click="OnAutoUpdateToggle" />
          <ToggleMenuFlyoutItem x:Name="RcUpdateItem" Text="Receive Release Candidates" Click="OnRcUpdateToggle" />
        </MenuBarItem>
      </MenuBar>

      <!-- The agent control: "Connect your AI agent", "Claude Code
           connected" with a dot, or a busy ring and "Claude Code is
           editing". Hidden after the user turned agents off. -->
      <Button x:Name="AgentButton" Grid.Column="1" Margin="0,0,8,0" Padding="10,4,10,4"
              VerticalAlignment="Center" Click="OnAgentButton"
              Background="Transparent" BorderThickness="0">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="&#x2726;" VerticalAlignment="Center" FontSize="14"
                     Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
          <InfoBadge x:Name="AgentDot" Visibility="Collapsed" VerticalAlignment="Center"
                     Style="{ThemeResource SuccessDotInfoBadgeStyle}" />
          <ProgressRing x:Name="AgentBusy" Visibility="Collapsed" IsActive="False"
                        Width="14" Height="14" VerticalAlignment="Center" />
          <TextBlock x:Name="AgentLabel" Text="Connect your AI agent" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </Grid>

    <!-- "Update available" (MainWindow.Updates.cs): Install downloads and
         checks the MSI, then installs it silently after one UAC prompt and
         restarts; closing the bar is "Later" for that version. -->
    <StackPanel Grid.Row="1">
      <InfoBar x:Name="UpdateBar" Margin="8,0,8,8" IsOpen="False" Severity="Informational"
               IsClosable="True" CloseButtonClick="OnUpdateLater">
        <InfoBar.ActionButton>
          <Button x:Name="UpdateButton" Content="Install" Click="OnUpdateInstall" />
        </InfoBar.ActionButton>
      </InfoBar>

      <!-- "Claude Code wants to change …" (MainWindow.Agents.cs): only
           when the user chose "Ask Before Applying Agent Edits". Apply
           applies it as one undoable, highlighted step; closing the bar
           declines it. -->
      <InfoBar x:Name="AgentEditBar" Margin="8,0,8,8" IsOpen="False" Severity="Informational"
               IsClosable="True" CloseButtonClick="OnAgentEditReject">
        <InfoBar.ActionButton>
          <Button x:Name="AgentApplyButton" Content="Apply" Click="OnAgentEditApply" />
        </InfoBar.ActionButton>
      </InfoBar>

      <!-- "The file changed on disk" (DocumentSession.Disk.cs): another
           program wrote the document's file while it had unsaved changes,
           or removed it. Reload takes the file's text as one undoable
           step; closing the bar keeps the window's, and Save then asks
           before overwriting. -->
      <InfoBar x:Name="DiskBar" Margin="8,0,8,8" IsOpen="False" Severity="Warning"
               IsClosable="True" CloseButtonClick="OnDiskKeepMine">
        <InfoBar.ActionButton>
          <Button x:Name="DiskReloadButton" Content="Reload" Click="OnDiskReload" />
        </InfoBar.ActionButton>
      </InfoBar>
    </StackPanel>

    <SplitView x:Name="SidePanes" Grid.Row="2" PanePlacement="Right" DisplayMode="Inline"
               IsPaneOpen="False" OpenPaneLength="360" PaneBackground="Transparent">
      <SplitView.Pane>
        <Border Margin="0,0,8,0" CornerRadius="{StaticResource OverlayCornerRadius}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <SelectorBar x:Name="PanelTabs" SelectionChanged="OnPanelTab">
                <SelectorBarItem Text="Customizer" Tag="customizer" />
                <SelectorBarItem Text="Check" Tag="check" />
                <SelectorBarItem Text="Measure" Tag="measure" />
              </SelectorBar>
              <Button Grid.Column="1" Margin="0,0,4,0" Click="OnClosePanels"
                      Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Hide the panels">
                <FontIcon Glyph="&#xE711;" FontSize="12" />
              </Button>
            </Grid>
            <ContentControl x:Name="PanelHost" Grid.Row="1" HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" />
          </Grid>
        </Border>
      </SplitView.Pane>

      <Grid Padding="8,0,8,0" ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="240" />
          <ColumnDefinition Width="*" MinWidth="240" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" CornerRadius="{StaticResource OverlayCornerRadius}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
          <Grid>
            <WebView2 x:Name="EditorView" />
            <TextBlock x:Name="EditorError" Visibility="Collapsed" Margin="16"
                       TextWrapping="Wrap" Style="{ThemeResource BodyTextBlockStyle}" />
          </Grid>
        </Border>

        <Grid Grid.Column="1" RowSpacing="8">
          <Grid.RowDefinitions>
            <RowDefinition Height="3*" />
            <RowDefinition Height="*" MinHeight="96" />
          </Grid.RowDefinitions>
          <Border Grid.Row="0" CornerRadius="{StaticResource OverlayCornerRadius}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid>
              <SwapChainPanel x:Name="ViewPanel" />
              <TextBlock x:Name="ViewError" Visibility="Collapsed" Margin="16"
                         TextWrapping="Wrap" Style="{ThemeResource BodyTextBlockStyle}" />
              <!-- "2 agent marks" and a clear button while an agent's marks
                   show (MainWindow.Agents.cs; the macOS app's chip). The
                   button's tooltip and name are set from AgentMarks. -->
              <Border x:Name="AgentMarksChip" Visibility="Collapsed" Margin="8" Padding="10,0,0,0"
                      HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="14"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="&#x2726;" VerticalAlignment="Center" FontSize="12"
                             Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                  <TextBlock x:Name="AgentMarksLabel" VerticalAlignment="Center"
                             Style="{ThemeResource CaptionTextBlockStyle}" />
                  <Button x:Name="AgentMarksClear" Click="OnClearAgentMarks" Padding="7"
                          CornerRadius="14" Background="Transparent" BorderThickness="0">
                    <FontIcon Glyph="&#xE711;" FontSize="10" />
                  </Button>
                </StackPanel>
              </Border>
            </Grid>
          </Border>
          <Border Grid.Row="1" CornerRadius="{StaticResource OverlayCornerRadius}"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <ListView x:Name="ConsoleList" SelectionMode="None" Padding="0,4,0,4" />
          </Border>
        </Grid>
      </Grid>
    </SplitView>

    <TextBlock x:Name="Status" Grid.Row="3" Margin="12,6,12,8"
               Style="{ThemeResource CaptionTextBlockStyle}"
               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
  </Grid>
</Window>
