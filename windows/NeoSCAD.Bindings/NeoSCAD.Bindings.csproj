<!--
  The C# binding of the Rust core (crates/ffi), generated by
  uniffi-bindgen-cs into Generated/ (scripts/windows/build-core.ps1; not
  checked in, like the Swift binding), plus the core's native library for
  the running platform, copied next to whatever references this project.

  Plain net10.0, not a Windows target, so the binding and the host logic
  above it build and test on Linux and macOS too (scripts/windows/docker-test.sh).
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>NeoSCAD.Native</RootNamespace>
    <!-- The generated code pins buffers and reads pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Generated code: its warnings are the generator's, not ours. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591;CS0108;CS0114;CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625;CS8765;CS8767;CS1573;CS0169;CS0414;CS0649</NoWarn>
    <!-- The platform whose library is copied: the one being built for,
         else the SDK's own (win-x64, linux-arm64, ...). -->
    <NeoScadRid Condition="'$(NeoScadRid)' == '' and '$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</NeoScadRid>
    <NeoScadRid Condition="'$(NeoScadRid)' == ''">$(NETCoreSdkRuntimeIdentifier)</NeoScadRid>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(NeoScadNativeDir)$(NeoScadRid)\*neoscad_ffi.*"
          Exclude="$(NeoScadNativeDir)$(NeoScadRid)\*.lib;$(NeoScadNativeDir)$(NeoScadRid)\*.a"
          CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" Visible="false" />
  </ItemGroup>

  <Target Name="NeoScadCheckBinding" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)Generated\neoscad_ffi.cs')"
           Text="The C# binding is missing: run scripts/windows/build-core.ps1 first (it builds crates/ffi and generates Generated/neoscad_ffi.cs)." />
  </Target>
</Project>
